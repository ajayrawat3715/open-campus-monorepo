# ==============================================================================
# COLLEGE MANAGEMENT SYSTEM - ENVIRONMENT VARIABLES
# ==============================================================================

# Required: MongoDB Connection String
# Example local: mongodb://localhost:27017/college-cms
# Example Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/college-cms?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/college-cms

# Required: Environment Mode
# Options: development | test | production
NODE_ENV=development

# Server Port (Default is 4000 for local app testing)
PORT=4000

# Base URL for API Clients (optional in local dev, inferred if omitted)
API_URL=http://localhost:4000

# Vercel Deployment URL (automatically provided in Vercel environments)
# VERCEL_URL=

# Playwright E2E Test Credentials (used by tests/e2e)
E2E_TEST_EMAIL=admin@college.edu
E2E_TEST_PASSWORD=AdminSecurePassword123!
